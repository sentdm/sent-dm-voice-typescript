{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "packages/voice-client-core": {
      "component": "voice-client-core"
    },
    "packages/voice-client": {
      "component": "voice-client",
      "extra-files": ["src/version.ts"]
    },
    "packages/voice-client-react": {
      "component": "voice-client-react"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "voice-client",
      "components": ["voice-client-core", "voice-client", "voice-client-react"]
    }
  ],
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "versioning": "prerelease",
  "prerelease": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-header": "Automated Release PR",
  "pull-request-title-pattern": "release: ${version}",
  "group-pull-request-title-pattern": "release: ${branch}",
  "release-type": "node",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "chore",
      "section": "Chores"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "style",
      "section": "Styles"
    },
    {
      "type": "refactor",
      "section": "Refactors"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System"
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    }
  ]
}
