{
  "name": "@sentdm/voice-client-core",
  "version": "0.1.1",
  "description": "The shared core of the Sent Voice Client packages. Internal to them: apps install @sentdm/voice-client",
  "author": "Sent <support@sent.dm>",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentdm/sent-dm-voice-typescript.git",
    "directory": "packages/voice-client-core"
  },
  "license": "Apache-2.0",
  "files": [
    "**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "bowser": "2.14.1"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  }
}
